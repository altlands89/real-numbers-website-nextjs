# Supabase project connection
# Get these from: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Payload CMS
# Generate a random string for the secret (e.g. `openssl rand -hex 32`).
PAYLOAD_SECRET=
# Supabase direct Postgres connection string (Project Settings -> Database
# -> Connection string -> URI, direct connection, not the pooler port).
DATABASE_URI=
# Vercel Blob store token (Vercel dashboard -> Storage -> Create Database
# -> Blob), used to store every image uploaded through /admin.
BLOB_READ_WRITE_TOKEN=
